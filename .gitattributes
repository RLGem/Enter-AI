# Line endings — added 21.9.2026.
# Git stores text as LF and checks it out per the rules below, so a file edited by a
# Windows tool and one edited in WSL no longer look different to git.

* text=auto

# Shell scripts must keep LF even on Windows, or bash refuses them
*.sh        text eol=lf
*.bash      text eol=lf

# Windows scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.vbs       text eol=crlf

# Binary — never touched, never diffed as text
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       text
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.zip       binary
*.mp4       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.jks       binary
*.keystore  binary
